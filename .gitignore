# The Squiggle server is a separate proprietary program with its own repository.
# Everything below is ignored so a checkout sitting alongside the editor can
# never be committed into this GPL-licensed tree by accident — the boundary is
# the whole point, and one `git add -A` on a bad day is all it would take.
collab-server/
scripts/
deploy.sh
deploy.cmd
Dockerfile
docker-compose.yml
.dockerignore
start.cmd
host-online.cmd
package.json
package-lock.json
docs/ARCHITECTURE.md
docs/DEPLOY.md
docs/cloudflare.md

# deployment target config (host names, users) stays local
.deploy.env

# local scratch files
*.log
collab-integration.patch
