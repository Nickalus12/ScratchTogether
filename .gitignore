# dependencies / build output
node_modules/
scratch-gui/build/
scratch-gui/dist/
scratch-gui/translations/

# server data — rooms, saved projects, users are runtime state, never source
collab-server/rooms/
collab-server/projects/
collab-server/users.json
# the stop token is minted fresh every boot
collab-server/run/
collab-server/tls/

# deployment target config (host names, users) stays local
.deploy.env

# local scratch files
*.log
collab-integration.patch

# sqlite metadata store — runtime state
collab-server/*.db
collab-server/*.db-wal
collab-server/*.db-shm
collab-server/squiggle.db*

# the generated starter is committed on purpose — it ships with the server
!collab-server/starter/welcome.sb3
